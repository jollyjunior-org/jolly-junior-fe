# Client-side API bases (Next.js — must use NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_AUTH_API_BASE_URL=http://localhost:8001/api/v1
NEXT_PUBLIC_ADMIN_API_BASE_URL=http://localhost:8002/api/v1
NEXT_PUBLIC_PUBLIC_API_BASE_URL=http://localhost:8003/api/v1

