# Production Client-side API bases for JollyJuniors.com
# These variables will be baked into the Next.js bundle at build time

# Authentication Service
NEXT_PUBLIC_AUTH_API_BASE_URL=https://api.jollyjuniors.com/auth/api/v1

# Storefront Public Service
NEXT_PUBLIC_PUBLIC_API_BASE_URL=https://api.jollyjuniors.com/api/v1
